+// Hathor patch: the default font weight, 400 plus the system's font weight adjustment (+300 with
+// Android's "Bold text" setting), read once from the app's FontWeightAdjustment native module.
+// A change to the setting applies after the app restarts.
+const NativeModules = require('../BatchedBridge/NativeModules');
+let defaultFontWeight: ?string = null;
+function getDefaultFontWeight(): string {
+  if (defaultFontWeight == null) {
+    const nativeModule = NativeModules.FontWeightAdjustment;
+    const constants = nativeModule?.getConstants
+      ? nativeModule.getConstants()
+      : nativeModule;
+    const adjustment = Number(constants?.fontWeightAdjustment) || 0;
+    // React Native accepts the weights 100 to 900, in steps of 100.
+    const weight = Math.round((400 + adjustment) / 100) * 100;
+    defaultFontWeight = String(Math.min(900, Math.max(100, weight)));
+  }
+  return defaultFontWeight;
+}
