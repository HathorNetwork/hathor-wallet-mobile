<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>aps-environment</key>
	<string>production</string>
	<!-- Passkey (PRF) wallets: passkeys are bound to PASSKEY_RP_ID (src/constants.js). That domain
	     must serve /.well-known/apple-app-site-association with a "webcredentials" entry for this
	     app's Team ID + bundle ID. -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>webcredentials:wallet.hathor.network</string>
	</array>
</dict>
</plist>
