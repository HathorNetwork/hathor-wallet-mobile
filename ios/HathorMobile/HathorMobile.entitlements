<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>aps-environment</key>
	<string>production</string>
	<!-- Passkey (PRF) onboarding: platform passkeys are bound to this domain. It must serve
	     https://wallet.hathor.dev/.well-known/apple-app-site-association with a "webcredentials"
	     entry for this app's Team ID + bundle ID. See docs/PASSKEY_ONBOARDING.md. -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>webcredentials:wallet.hathor.dev</string>
	</array>
</dict>
</plist>
